{
  "name": "Komari 毛玻璃增强主题（MXH）",
  "short": "GlassmorphismEnhanced",
  "description": "MXH 个人适配版 Komari 毛玻璃主题，支持历史指标兼容访问、自定义站点图标、默认节点顺序及 IPv4/IPv6/WARP 三网延迟与丢包历史",
  "version": "2.2.2-mxh.8",
  "author": "jianmomo / mxh110708",
  "url": "https://github.com/mxh110708/komari-theme-Glassmorphism-Enhanced-Custom",
  "preview": "preview-v2.0.0.png",
  "configuration": {
    "type": "managed",
    "name": "MXH Status 外观",
    "data": [
      {
        "name": "基础设置",
        "type": "title"
      },
      {
        "name": "<div style=\"display:grid;gap:8px;padding:4px 2px 8px;color:var(--gray-11)\"><div style=\"font-size:14px;line-height:1.7\">设置主题外观、数据刷新周期与节点展示方式。</div></div>",
        "type": "textbox"
      },
      {
        "key": "themeMode",
        "name": "默认主题模式",
        "type": "select",
        "default": "自动",
        "options": "自动,浅色,深色",
        "help": "自动模式按北京时间在 07:00–18:59 使用浅色，其余时段使用深色。页眉按钮可切换当前浏览器的显示模式。"
      },
      {
        "key": "dataUpdateInterval",
        "name": "数据更新间隔（秒）",
        "type": "number",
        "default": 3,
        "help": "实时数据刷新周期，取值范围为 1–60 秒。"
      },
      {
        "name": "<div style=\"display:grid;gap:12px;padding:16px 18px;border:1px solid var(--gray-a6);border-radius:12px;background:linear-gradient(135deg,var(--accent-a3),var(--gray-a2))\"><div style=\"display:grid;gap:4px\"><strong style=\"font-size:15px;color:var(--gray-12)\">站点图标</strong><span style=\"font-size:13px;line-height:1.65;color:var(--gray-11)\">上传至本站后，用于浏览器标签页和主题页眉。文件大小不得超过 5 MiB。</span></div><div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap\"><a href=\"/admin/settings/site\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:0 14px;border-radius:8px;background:var(--accent-9);color:white;font-size:13px;font-weight:600;text-decoration:none\">上传站点图标</a><span style=\"font-size:12px;line-height:1.5;color:var(--gray-10)\">打开站点设置，在图标设置区域上传或恢复默认图标。</span></div></div>",
        "type": "textbox"
      },
      {
        "key": "siteIconUrl",
        "name": "外部图标地址（可选）",
        "type": "string",
        "default": "",
        "help": "填写 HTTPS 地址或以 / 开头的站内路径。设置后优先使用此图标；留空时使用已上传的站点图标，未上传则使用默认图标。"
      },
      {
        "key": "rpcTransportMode",
        "name": "RPC 连接模式",
        "type": "select",
        "default": "HTTP",
        "options": "HTTP,WebSocket",
        "help": "默认使用 HTTP。选择 WebSocket 前，请确认反向代理支持连接升级。"
      },
      {
        "key": "defaultViewMode",
        "name": "默认视图模式",
        "type": "select",
        "default": "卡片",
        "options": "卡片,列表",
        "help": "设置首页节点的默认展示方式；访客可在页面中切换视图。"
      },
      {
        "key": "nodeCardSize",
        "name": "节点卡片尺寸",
        "type": "select",
        "default": "紧凑",
        "options": "紧凑,标准,大型",
        "help": "设置节点卡片的宽度与间距，仅对卡片视图生效。"
      },
      {
        "name": "首页模块设置",
        "type": "title"
      },
      {
        "name": "<div style=\"display:grid;gap:8px;padding:4px 2px 8px;color:var(--gray-11)\"><div style=\"font-size:14px;line-height:1.7\">设置首页公告、地球展示、总览卡片与访客信息。</div></div>",
        "type": "textbox"
      },
      {
        "key": "alertEnabled",
        "name": "启用公告",
        "type": "switch",
        "default": false,
        "help": "在首页顶部显示自定义公告。"
      },
      {
        "key": "alertTitle",
        "name": "公告标题",
        "type": "string",
        "default": "",
        "help": "仅在启用公告后显示。"
      },
      {
        "key": "alertContent",
        "name": "公告内容",
        "type": "richtext",
        "default": "",
        "help": "设置公告正文，支持基础 Markdown 格式。"
      },
      {
        "key": "stopEarth",
        "name": "停止地球旋转",
        "type": "switch",
        "default": false,
        "help": "关闭地球的自动旋转；手动拖动不受影响。"
      },
      {
        "key": "earthRenderer",
        "name": "地球与地图样式",
        "type": "select",
        "default": "立体地球",
        "options": "立体地球,点阵地球,平面地图",
        "help": "选择首页地球或地图的展示样式。"
      },
      {
        "key": "hideEarth",
        "name": "隐藏地球",
        "type": "switch",
        "default": false,
        "help": "隐藏地球，仅保留首页总览卡片。"
      },
      {
        "key": "hideGeneralCard",
        "name": "隐藏首页总览区域",
        "type": "switch",
        "default": false,
        "help": "同时隐藏地球与首页总览卡片。"
      },
      {
        "key": "visitorInfoEnabled",
        "name": "显示访客信息",
        "type": "switch",
        "default": true,
        "help": "显示当前访客的 IP 地址与设备信息。"
      },
      {
        "key": "generalCardPreset",
        "name": "总览卡片方案",
        "type": "select",
        "default": "基础",
        "options": "基础,运维,财务,流量,完整,自定义",
        "help": "选择总览指标组合；自定义方案使用下方指定的指标。"
      },
      {
        "key": "generalCardKeys",
        "name": "自定义总览指标",
        "type": "string",
        "default": "",
        "help": "仅对自定义方案生效。按显示顺序填写指标名称，以逗号分隔。"
      },
      {
        "name": "<details style=\"padding:12px 14px;border:1px solid var(--gray-a5);border-radius:10px;background:var(--gray-a2)\"><summary style=\"cursor:pointer;font-size:13px;font-weight:600;color:var(--gray-12)\">可用总览指标</summary><div style=\"margin-top:10px;font-size:12px;line-height:1.85;color:var(--gray-11)\">内存、硬盘、剩余价值、累计流量、实时上行、实时下行、在线节点、离线节点、高负载节点、即将到期、实时峰值、上行最高、下行最高、流量预警、连接峰值、月费用、年费用、平均 CPU、平均负载、交换内存、进程数、连接数、CPU 核心、流量配额、地区分布、系统分布、虚拟化。</div></details>",
        "type": "textbox"
      },
      {
        "key": "hideAdminEntryWhenLoggedOut",
        "name": "隐藏后台入口",
        "type": "switch",
        "default": false,
        "help": "访客未登录时不显示顶部后台管理入口。"
      },
      {
        "key": "hidePriceWhenLoggedOut",
        "name": "未登录时隐藏价格",
        "type": "switch",
        "default": false,
        "help": "访客未登录时隐藏价格、剩余价值与费用信息。"
      },
      {
        "key": "providerAliases",
        "name": "服务商识别别名",
        "type": "string",
        "default": "",
        "help": "格式：服务商名称:别名1,别名2；多组以英文分号（;）分隔。"
      },
      {
        "key": "disablePageAnimation",
        "name": "减弱过渡动画",
        "type": "switch",
        "default": false,
        "help": "减少页面过渡动画，适合低性能设备或无障碍需求。"
      },
      {
        "name": "节点与快捷控制",
        "type": "title"
      },
      {
        "name": "<div style=\"display:grid;gap:8px;padding:4px 2px 8px;color:var(--gray-11)\"><div style=\"font-size:14px;line-height:1.7\">设置首页筛选、节点排序与预警阈值。</div></div>",
        "type": "textbox"
      },
      {
        "key": "networkLatencyRatingMode",
        "name": "延迟评级模式",
        "type": "select",
        "default": "地理距离",
        "options": "地理距离,固定阈值",
        "help": "按机房与检测目标的地理距离使用统一评级公式；同地区共用阈值，不按服务器、运营商或历史延迟放宽。真实延迟与检测失败率保持不变；无法确定位置时暂不评级。"
      },
      {
        "key": "networkLatencyNodeLocations",
        "name": "机房位置补充（可选）",
        "type": "string",
        "default": "",
        "help": "自动识别节点名称中的洛杉矶、圣何塞、法兰克福及其城市缩写，不以国家中心或访客位置替代机房。其他位置可填写 JSON 数组：[{\"match\":\"节点名称关键词\",\"label\":\"城市名称\",\"latitude\":纬度,\"longitude\":经度}]。补充项优先；多个匹配位置冲突时暂不评级。"
      },
      {
        "key": "networkLatencyTaskLocations",
        "name": "检测目标位置补充（可选）",
        "type": "string",
        "default": "",
        "help": "根据检测任务名称识别地区；广东使用广州作为地区参考点，三网与 IPv4/IPv6 共用位置。实际目标不在该地区或需要更精确坐标时，可填写 JSON 数组：[{\"match\":\"任务名称关键词\",\"label\":\"目标地区\",\"latitude\":纬度,\"longitude\":经度}]。不使用浏览器所在地或历史延迟推断位置。"
      },
      {
        "key": "homeQuickControlsEnabled",
        "name": "显示首页快捷控制",
        "type": "switch",
        "default": true,
        "help": "在节点分组旁显示筛选和排序快捷按钮。"
      },
      {
        "key": "homeQuickControlPreset",
        "name": "快捷控制方案",
        "type": "select",
        "default": "完整",
        "options": "基础,流量,运维,完整,自定义",
        "help": "选择筛选与排序按钮组合；自定义方案使用下方指定的按钮。"
      },
      {
        "key": "homeQuickControlKeys",
        "name": "自定义快捷按钮",
        "type": "string",
        "default": "",
        "help": "仅对自定义方案生效。按显示顺序填写按钮名称，以逗号分隔。"
      },
      {
        "name": "<details style=\"padding:12px 14px;border:1px solid var(--gray-a5);border-radius:10px;background:var(--gray-a2)\"><summary style=\"cursor:pointer;font-size:13px;font-weight:600;color:var(--gray-12)\">可用快捷按钮</summary><div style=\"margin-top:10px;font-size:12px;line-height:1.85;color:var(--gray-11)\">默认、月费用、累计流量、上行、下行、峰值、离线、高负载、即将到期。</div></details>",
        "type": "textbox"
      },
      {
        "key": "homeQuickDefaultControl",
        "name": "默认快捷模式",
        "type": "select",
        "default": "默认",
        "options": "默认,月费用,累计流量,上行,下行,峰值,离线,高负载,即将到期",
        "help": "设置进入首页时自动启用的筛选或排序模式。"
      },
      {
        "key": "homeDefaultNodeOrder",
        "name": "默认节点顺序",
        "type": "string",
        "default": "DMIT,VMISS,YUNYOO,BreadCloud",
        "help": "按顺序填写节点名称关键词，以英文逗号（,）分隔，不区分大小写。未匹配节点按 Komari 中设置的顺序排列。"
      },
      {
        "key": "homeHighLoadThreshold",
        "name": "高负载阈值（%）",
        "type": "number",
        "default": 80,
        "help": "CPU、内存或硬盘使用率达到该值时标记为高负载，取值范围为 1–100。"
      },
      {
        "key": "homeTrafficWarningThreshold",
        "name": "流量预警阈值（%）",
        "type": "number",
        "default": 80,
        "help": "流量配额使用率达到该值时显示预警，取值范围为 1–100。"
      },
      {
        "key": "homeExpiringDays",
        "name": "到期预警天数",
        "type": "number",
        "default": 30,
        "help": "剩余使用天数不超过该值时标记为即将到期。"
      },
      {
        "name": "自定义背景",
        "type": "title"
      },
      {
        "name": "<div style=\"display:grid;gap:8px;padding:4px 2px 8px;color:var(--gray-11)\"><div style=\"font-size:14px;line-height:1.7\">分别设置浅色与深色模式的背景，以及模糊和遮罩效果。</div></div>",
        "type": "textbox"
      },
      {
        "key": "backgroundEnabled",
        "name": "启用自定义背景",
        "type": "switch",
        "default": false,
        "help": "启用后，根据当前主题模式加载对应的背景资源。"
      },
      {
        "key": "backgroundType",
        "name": "背景类型",
        "type": "select",
        "default": "图片",
        "options": "图片,视频",
        "help": "选择静态图片或视频背景。"
      },
      {
        "key": "lightBackgroundUrl",
        "name": "浅色模式背景地址",
        "type": "string",
        "default": "",
        "help": "浅色模式使用的 HTTPS 图片或视频地址。"
      },
      {
        "key": "darkBackgroundUrl",
        "name": "深色模式背景地址",
        "type": "string",
        "default": "",
        "help": "深色模式使用的 HTTPS 图片或视频地址。"
      },
      {
        "key": "backgroundBlur",
        "name": "背景模糊半径（像素）",
        "type": "number",
        "default": 0,
        "help": "设置背景的高斯模糊半径，0 表示不使用模糊。"
      },
      {
        "key": "backgroundOverlay",
        "name": "背景遮罩强度（%）",
        "type": "number",
        "default": 0,
        "help": "取值范围为 -100–100。正值增加黑色遮罩，负值降低背景不透明度，0 表示不调整。"
      }
    ]
  }
}
